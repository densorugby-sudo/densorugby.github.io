---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PageTop from "../components/PageTop.astro";

const articles = [
  { href: "news/n_update20260829.html", date: "2026.08.29", title: "公式サイトをアップデートしました！", image: "webupdate.jpg" },
  { href: "news/n_shinkan2026.html", date: "2026.03.24", title: "2026年度新歓のお知らせ", image: "shinkanletter.jpg" },
  { href: "news/n_renewal2.html", date: "2026.03.12", title: "本サイトのレスポンシブ対応について", image: "background.jpg" },
  { href: "news/n_uecfest2025.html", date: "2025.11.30", title: "調布祭2025無事終了です！", image: "uecfest2025/pizza1.JPG" },
  { href: "news/n_tc2025.html", date: "2025.09.25", title: "夏の菅平合宿のレポートを公開しました！", image: "tc2025summer/sania0906.JPG" },
  { href: "news/n_renewal.html", date: "2025.09.13", title: "公式サイトをリニューアルしました！", image: "webupdate.jpg" },
  { href: "news/n_X.html", date: "2025.08.24", title: "X(旧Twitter)アカウントをリニューアルしました！", image: "image1.jpg" },
];
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NEWS|電気通信大学×早稲田大学理工ラグビー部</title>
  <meta name="description" content="電早ラグビー部の最新情報、活動報告、新歓情報を掲載しています。">
  <link rel="stylesheet" href={`${base}style.css`}>
</head>
<body class="home-page site-page news-index-page">
  <SiteHeader active="news" />
  <PageTop />
  <main class="sub-main">
    <header class="page-hero">
      <span>NEWS</span>
      <h1>ニュース</h1>
      <p>電早ラグビー部の最新情報と活動の様子をお届けします。</p>
    </header>
    <section class="news-archive" aria-label="ニュース一覧">
      {articles.map((article) => (
        <article class="archive-card">
          <a href={`${base}${article.href}`}>
            <img src={`${base}${article.image}`} alt="">
            <div><time>{article.date}</time><h2>{article.title}</h2><span>記事を読む →</span></div>
          </a>
        </article>
      ))}
    </section>
  </main>
  <SiteFooter />
  <script is:inline src={`${base}js/site.js`}></script>
</body>
</html>
