---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PageTop from "../components/PageTop.astro";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ACCESS|電気通信大学×早稲田大学理工ラグビー部</title>
  <meta name="description" content="電早ラグビー部が活動する電通大多摩川グラウンドへのアクセス情報です。">
  <link rel="stylesheet" href={`${base}style.css`}>
</head>
<body class="home-page site-page access-page">
  <SiteHeader active="access" />
  <PageTop />
  <main class="sub-main">
    <header class="page-hero page-hero--access">
      <span>ACCESS</span>
      <h1>電通大多摩川グラウンドへのアクセス</h1>
      <p>練習見学・体験参加の際はこちらをご確認ください。</p>
    </header>
    <section class="access-layout">
      <div class="access-map">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d13305.473652392679!2d139.54635254710192!3d35.63989576901674!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6018f066f49b8133%3A0xf421a20d6a53f806!2z6Zu75rCX6YCa5L-h5aSn5a2m5aSa5pGp5bed44Kw44Op44Km44Oz44OJ!5e0!3m2!1sja!2sjp!4v1755532602302!5m2!1sja!2sjp"
          title="電通大多摩川グラウンドの地図" allowfullscreen loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <div class="access-details">
        <span class="section-kicker">ROUTE</span>
        <h2>グラウンドまでの目安</h2>
        <dl>
          <div><dt>BUS</dt><dd><b>バス</b>：調布駅→「調布駅南口」→「電通大グランド前」　約8分</dd></div>
          <div><dt>CAR</dt><dd><b>車</b>：調布駅から約6分</dd></div>
          <div><dt>WALK</dt><dd><b>徒歩</b>：調布駅から約19分</dd></div>
        </dl>
        <a class="access-contact" href="https://www.instagram.com/uec_waseda/">見学について相談する →</a>
        <p class="access-contact-note">DMまでご連絡ください！</p>
      </div>
    </section>
  </main>
  <SiteFooter />
  <script is:inline src={`${base}js/site.js`}></script>
</body>
</html>
