---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PageTop from "../components/PageTop.astro";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const pathosPhotos = Array.from({ length: 5 }, (_, index) => ({
  src: `results/2026/0906/20260906_${index + 1}.jpg`,
  alt: `菅平合宿・中央大パトス戦の写真 ${index + 1}`,
}));
const photos = Array.from({ length: 6 }, (_, index) => ({
  src: `results/2026/0905/20260905_${index + 1}.jpg`,
  alt: `2026年9月5日 菅平合宿・くるみクラブ戦の写真 ${index + 1}`,
}));
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RESULTS|電気通信大学×早稲田大学理工ラグビー部</title>
  <meta name="description" content="電早ラグビー部の試合結果とフォトギャラリー。2026年の菅平合宿の試合結果を掲載しています。">
  <link rel="stylesheet" href={`${base}style.css`}>
</head>
<body class="home-page site-page results-page">
  <SiteHeader active="results" />
  <PageTop />
  <main class="sub-main">
    <header class="page-hero">
      <span>RESULTS</span>
      <h1>試合結果</h1>
    </header>

    <section class="results-season" aria-labelledby="season-title">
      <div class="season-heading">
        <h2 id="season-title">2026<span>年</span></h2>
        <span class="section-kicker">SEASON RESULTS</span>
      </div>
      <section aria-labelledby="camp-title">
        <div class="camp-heading"><span aria-hidden="true"></span><h3 id="camp-title">菅平合宿</h3></div>
        <article class="match-card" aria-labelledby="pathos-match-title">
          <div class="match-meta"><time datetime="2026-08-06">8/6 <span>(日)</span></time><span>試合終了</span></div>
          <h4 id="pathos-match-title" class="match-score" aria-label="電早 8 対 22 中央大パトス">
            <span class="team-name team-name--home"><img class="team-logo" src={`${base}rugby_logo.PNG`} alt="" width="112" height="112">電早</span>
            <span class="score">8 <span class="score-divider">–</span> 22</span>
            <span class="team-name"><img class="team-logo" src={`${base}pathos_logo.jpg`} alt="" width="112" height="112">中央大パトス</span>
          </h4>
          <section class="match-gallery" aria-label="中央大パトス戦のフォトギャラリー">
            <div class="gallery-heading">
              <h5>GALLERY</h5>
              <div class="gallery-controls" hidden>
                <button type="button" data-direction="-1" aria-label="前の写真へ" aria-controls="pathos-match-photos">←</button>
                <button type="button" data-direction="1" aria-label="次の写真へ" aria-controls="pathos-match-photos">→</button>
              </div>
            </div>
            <div class="gallery-track" id="pathos-match-photos" tabindex="0" role="region" aria-label="中央大パトス戦の写真">
              {pathosPhotos.map((photo) => (
                <figure><button class="gallery-photo" type="button" aria-label={`${photo.alt}を拡大表示`} aria-haspopup="dialog"><img src={`${base}${photo.src}`} alt={photo.alt} loading="lazy" width="720" height="480" /></button></figure>
              ))}
            </div>
          </section>
        </article>
        <article class="match-card" aria-labelledby="match-title">
          <div class="match-meta"><time datetime="2026-09-05">9/5 <span>(土)</span></time><span>試合終了</span></div>
          <h4 id="match-title" class="match-score" aria-label="電早 8 対 19 くるみクラブ">
            <span class="team-name team-name--home"><img class="team-logo" src={`${base}rugby_logo.PNG`} alt="" width="112" height="112">電早</span>
            <span class="score">8 <span class="score-divider">–</span> 19</span>
            <span class="team-name"><img class="team-logo" src={`${base}kurumi_logo.jpg`} alt="" width="112" height="112">くるみクラブ</span>
          </h4>
          <section class="match-gallery" aria-label="試合のフォトギャラリー">
            <div class="gallery-heading">
              <h5>GALLERY</h5>
              <div class="gallery-controls" hidden>
                <button type="button" data-direction="-1" aria-label="前の写真へ" aria-controls="match-photos">←</button>
                <button type="button" data-direction="1" aria-label="次の写真へ" aria-controls="match-photos">→</button>
              </div>
            </div>
            <div class="gallery-track" id="match-photos" tabindex="0" role="region" aria-label="9月5日 くるみクラブ戦の写真">
              {photos.length ? photos.map((photo) => (
                <figure><button class="gallery-photo" type="button" aria-label={`${photo.alt}を拡大表示`} aria-haspopup="dialog"><img src={`${base}${photo.src}`} alt={photo.alt} loading="lazy" width="720" height="480" /></button></figure>
              )) : [1, 2, 3].map((number) => (
                <div class="photo-placeholder"><span class="photo-number" aria-hidden="true">0{number}</span><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8" cy="10" r="1.5"/><path d="m3 17 5-4 4 3 4-6 5 7"/></svg><span>写真準備中</span></div>
              ))}
            </div>
          </section>
        </article>
      </section>
    </section>
  </main>
  <SiteFooter />
  <dialog class="photo-dialog" aria-label="写真の拡大表示">
    <button class="photo-dialog-close" type="button" aria-label="拡大表示を閉じる" autofocus>×</button>
    <img class="photo-dialog-image" alt="">
  </dialog>
  <script is:inline src={`${base}js/site.js`}></script>
</body>
</html>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.photo-dialog');
  const enlargedImage = dialog?.querySelector<HTMLImageElement>('.photo-dialog-image');
  if (dialog && enlargedImage) {
    let previousOverflow = '';
    document.querySelectorAll<HTMLButtonElement>('.gallery-photo').forEach(button => {
      button.addEventListener('click', () => {
        const photo = button.querySelector('img');
        if (!photo) return;
        enlargedImage.src = photo.currentSrc || photo.src;
        enlargedImage.alt = photo.alt;
        previousOverflow = document.documentElement.style.overflow;
        document.documentElement.style.overflow = 'hidden';
        dialog.showModal();
      });
    });
    dialog.querySelector('.photo-dialog-close')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', event => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = previousOverflow;
    });
  }
  document.querySelectorAll<HTMLElement>('.match-gallery').forEach(gallery => {
    const track = gallery.querySelector<HTMLElement>('.gallery-track');
    const controls = gallery.querySelector<HTMLElement>('.gallery-controls');
    if (!track || !controls) return;
    controls.hidden = false;
    const buttons = controls.querySelectorAll<HTMLButtonElement>('button');
    const update = () => {
      buttons[0].disabled = track.scrollLeft <= 1;
      buttons[1].disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
    };
    buttons.forEach(button => button.addEventListener('click', () => {
      const step = (track.firstElementChild?.getBoundingClientRect().width ?? track.clientWidth) + 16;
      track.scrollBy({ left: Number(button.dataset.direction) * step, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
    }));
    track.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(track);
    update();
  });
</script>

<style>
  .gallery-photo { display: block; width: 100%; height: 100%; padding: 0; border: 0; background: transparent; cursor: zoom-in; }
  .gallery-photo:focus-visible { outline-offset: -4px; }
  .photo-dialog { position: fixed; inset: 0; box-sizing: border-box; width: 100%; max-width: none; height: 100%; height: 100dvh; max-height: none; margin: 0; padding: 72px 24px 24px; border: 0; background: transparent; }
  .photo-dialog[open] { display: flex; align-items: center; justify-content: center; }
  .photo-dialog::backdrop { background: rgb(0 0 0 / 88%); }
  .photo-dialog-image { display: block; width: auto; height: auto; max-width: min(80%, 1000px); max-height: 75%; object-fit: contain; }
  .photo-dialog-close { position: absolute; top: 16px; right: 16px; display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 1px solid #ffffff80; border-radius: 50%; background: #182126; color: white; font-size: 32px; line-height: 1; cursor: pointer; }
  .photo-dialog-close:hover { background: #34434a; }
  .results-season { width: min(calc(100% - 48px), 880px); margin: 0 auto; padding: 48px 0 72px; }
  .season-heading { display: flex; align-items: baseline; gap: 24px; border-bottom: 1px solid #d9e1e2; padding-bottom: 18px; margin-bottom: 28px; }
  .season-heading h2 { margin: 0; font-size: clamp(36px, 4vw, 48px); line-height: 1; letter-spacing: -.04em; color: var(--color-ink); }
  .season-heading h2 span { font-size: 20px; margin-left: 10px; }
  .camp-heading { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; }
  .camp-heading > span { width: 5px; height: 28px; border-radius: 4px; background: var(--color-waseda); }
  .camp-heading h3 { font-size: clamp(22px, 2.5vw, 26px); margin: 0; }
  .match-card { background: white; border: 1px solid #dce3e4; border-radius: 20px; overflow: hidden; box-shadow: 0 12px 36px rgb(5 24 31 / 4%); }
  .match-card + .match-card { margin-top: 28px; }
  .match-meta { display: flex; align-items: center; justify-content: space-between; padding: 16px 24px; border-bottom: 1px solid #e7eded; }
  .match-meta time { font-size: 20px; font-weight: 800; }
  .match-meta time span { font-size: 15px; margin-left: 4px; }
  .match-meta > span { font-size: 12px; font-weight: 700; color: #52646a; background: #edf2f2; border-radius: 20px; padding: 6px 14px; }
  .match-score { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 24px; margin: 0; padding: 28px 24px; text-align: center; }
  .team-name { display: flex; flex-direction: column; align-items: center; gap: 12px; font-size: clamp(16px, 2vw, 22px); overflow-wrap: anywhere; }
  .team-logo { display: block; width: 88px; height: 88px; max-width: 100%; aspect-ratio: 1; object-fit: contain; border-radius: 0; background: white; }
  .team-name--home { color: #000; }
  .score { display: flex; align-items: center; gap: 24px; font-size: clamp(36px, 4vw, 52px); font-weight: 900; line-height: 1.2; font-variant-numeric: tabular-nums; }
  .score-divider { color: #93a2a6; font-size: 28px; font-weight: 400; }
  .match-gallery { border-top: 1px solid #e7eded; padding: 20px 24px 24px; }
  .gallery-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
  .gallery-heading h5 { margin: 0; font-size: 16px; letter-spacing: .1em; }
  .gallery-controls { display: flex; gap: 8px; }
  .gallery-controls[hidden] { display: none; }
  .gallery-controls button { width: 44px; height: 44px; border: 1px solid #cbd6d8; border-radius: 50%; background: white; color: var(--color-ink); font-size: 20px; cursor: pointer; }
  .gallery-controls button:hover:not(:disabled) { background: var(--color-ink); color: white; }
  .gallery-controls button:disabled { opacity: .3; cursor: default; }
  .gallery-track { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 16px; scrollbar-width: thin; scrollbar-color: #8a9da2 #edf2f2; }
  .gallery-track > * { flex: 0 0 42%; min-width: 0; margin: 0; aspect-ratio: 3 / 2; border-radius: 10px; overflow: hidden; scroll-snap-align: start; }
  .gallery-track img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .photo-placeholder { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; background: linear-gradient(135deg, #edf2f2, #e3ebec); color: #61767c; font-size: 13px; }
  .photo-number { position: absolute; top: 16px; left: 18px; font-size: 12px; letter-spacing: .12em; }
  .gallery-track:focus-visible, button:focus-visible { outline: 3px solid var(--color-uec); outline-offset: 4px; }
  @media (max-width: 600px) {
    .results-season { width: calc(100% - 32px); padding: 32px 0 48px; }
    .season-heading { gap: 16px; margin-bottom: 28px; }
    .season-heading .section-kicker { font-size: 10px; }
    .match-meta { padding: 14px 16px; }
    .match-score { gap: 10px; padding: 24px 16px; }
    .team-name { gap: 12px; }
    .team-logo { width: 64px; height: auto; }
    .score { gap: 8px; font-size: 40px; }
    .score-divider { font-size: 20px; }
    .match-gallery { padding: 16px; }
    .gallery-track > * { flex-basis: 86%; }
  }
</style>
